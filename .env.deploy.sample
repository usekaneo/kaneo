# Deployment environment for compose.deploy.yml
# Copy to .env.deploy and fill in values.
# IMPORTANT: never commit .env.deploy with real secrets.

# --- General URLs ---
# Public URL users hit (host port from compose.deploy.yml)
KANEO_CLIENT_URL=http://YOUR_VPS_IP:8082
# Optional; defaults to ${KANEO_CLIENT_URL}/api
# KANEO_API_URL=http://YOUR_VPS_IP:8082/api

# --- Database (external postgres-benchmark at 192.168.30.3:5432) ---
# Use the host-reachable IP. In .env.deploy, set the password you created for kaneo user.
DATABASE_URL=postgresql://kaneo:YOUR_STRONG_PASSWORD@192.168.30.3:5432/kaneo

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=REPLACE_WITH_64_HEX_CHARS

# --- CORS (optional) ---
# Comma-separated. Empty = allow all in dev. For production set your client URL.
# CORS_ORIGINS=http://YOUR_VPS_IP:8082

# --- Redis Pub/Sub (optional; omit = in-memory single instance) ---
# REDIS_URL=

# --- SSO providers (optional; leave empty to disable) ---
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- GitHub integration (optional) ---
# GITHUB_APP_ID=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PRIVATE_KEY=
# GITHUB_APP_NAME=

# --- SMTP (optional; leave empty to disable email) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_REQUIRE_TLS=

# --- Cloudflare Turnstile (optional; self-hosted usually leaves empty) ---
# TURNSTILE_SECRET_KEY=
# KANEO_TURNSTILE_SITE_KEY=

# --- Sentry (optional) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Billing via Creem (only active when KANEO_CLOUD=true; self-hosted leave empty) ---
# KANEO_CLOUD=false
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
