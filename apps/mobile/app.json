{
	"expo": {
		"name": "Kaneo",
		"slug": "kaneo",
		"version": "0.3.1",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "kaneo",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#FAFAFA",
		"ios": {
			"bundleIdentifier": "de.usekaneo.kaneo",
			"supportsTablet": true,
			"icon": "./assets/images/icon.png",
			"config": {
				"usesNonExemptEncryption": false
			},
			"infoPlist": {
				"NSAppTransportSecurity": {
					"NSAllowsArbitraryLoads": true
				},
				"CFBundleAllowMixedLocalizations": true
			}
		},
		"android": {
			"package": "de.usekaneo.kaneo",
			"versionCode": 4,
			"adaptiveIcon": {
				"backgroundColor": "#141414",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FAFAFA",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 64,
					"dark": {
						"backgroundColor": "#141414",
						"image": "./assets/images/splash-icon-dark.png"
					}
				}
			],
			[
				"expo-notifications",
				{
					"icon": "./assets/images/notification-icon.png",
					"color": "#141414",
					"defaultChannel": "kaneo_activity"
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Kaneo uses your photos to attach images to tasks and comments, and for your profile photo.",
					"cameraPermission": false,
					"microphonePermission": false
				}
			],
			"expo-secure-store",
			"expo-background-task",
			"expo-font",
			"./plugins/with-gradle-memory",
			"./plugins/with-release-signing",
			"./plugins/with-permission-locales",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true,
						"extraProguardRules": "# expo-background-task uses WorkManager 2.9.1 / Room 2.5.0. SDK 58 enables R8, so keep their reflectively invoked constructors.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
