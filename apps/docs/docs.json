{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "almond",
	"name": "Kaneo",
	"colors": {
		"primary": "#111111",
		"light": "#fafafa",
		"dark": "#1f1f1f"
	},
	"appearance": {
		"default": "dark"
	},
	"icons": {
		"library": "lucide"
	},
	"styling": {
		"codeblocks": {
			"theme": {
				"light": "min-light",
				"dark": "min-dark"
			}
		}
	},
	"fonts": {
		"family": "Geist Variable",
		"source": "/fonts/geist.woff2",
		"format": "woff2"
	},
	"favicon": "/favicon.svg",
	"logo": {
		"light": "/logo/dark.svg",
		"dark": "/logo/light.svg"
	},
	"redirects": [
		{
			"source": "/core/guide/migrating-from-v1",
			"destination": "/core/installation/environment-variables"
		}
	],
	"navigation": {
		"tabs": [
			{
				"tab": "Using Kaneo",
				"groups": [
					{
						"group": "Start here",
						"pages": [
							"index",
							"core/index",
							"core/functional/create-workspace-and-project"
						]
					},
					{
						"group": "Work with tasks",
						"pages": [
							"core/functional/plan-and-execute-tasks",
							"core/functional/backlog-planning",
							"core/functional/calendar-and-gantt",
							"core/functional/configure-workflows",
							"core/functional/manage-workspace-labels"
						]
					},
					{
						"group": "Your team and account",
						"pages": [
							"core/functional/collaborate-with-team",
							"core/functional/account-notifications",
							"core/functional/personalize-your-workspace",
							"core/functional/manage-your-account"
						]
					}
				]
			},
			{
				"tab": "Self-hosting",
				"groups": [
					{
						"group": "Install",
						"pages": [
							"core/installation/index",
							"core/installation/docker-compose",
							"core/installation/drim",
							"core/deployments/coolify",
							"core/deployments/railway"
						]
					},
					{
						"group": "Configure",
						"pages": [
							"core/reverse-proxy/nginx",
							"core/installation/object-storage-and-image-uploads",
							"core/installation/silo",
							"core/installation/storage-backends",
							"core/installation/environment-variables"
						]
					},
					{
						"group": "Sign-in providers",
						"pages": [
							"core/social-providers/github",
							"core/social-providers/google",
							"core/social-providers/discord",
							"core/social-providers/custom-oauth"
						]
					},
					{
						"group": "Keep it running",
						"pages": [
							"core/operations/backups",
							"core/operations/upgrades",
							"core/operations/troubleshooting"
						]
					},
					{
						"group": "Move to Kaneo",
						"pages": [
							"core/migrations/from-planka",
							"core/installation/migration",
							"core/installation/drim-migration"
						]
					}
				]
			},
			{
				"tab": "Integrations",
				"groups": [
					{
						"group": "Overview",
						"pages": ["core/integrations/index"]
					},
					{
						"group": "Repositories",
						"pages": [
							"core/integrations/github/setup",
							"core/integrations/github/configuration",
							"core/integrations/github/troubleshooting",
							"core/integrations/gitea/setup",
							"core/integrations/gitlab/setup"
						]
					},
					{
						"group": "Team updates",
						"pages": [
							"core/integrations/slack",
							"core/integrations/discord",
							"core/integrations/mattermost",
							"core/integrations/telegram",
							"core/integrations/outgoing-webhooks"
						]
					},
					{
						"group": "Personal notifications",
						"pages": [
							"core/integrations/ntfy",
							"core/integrations/gotify",
							"core/integrations/personal-webhooks"
						]
					},
					{
						"group": "AI assistants",
						"pages": ["core/integrations/mcp"]
					}
				]
			},
			{
				"tab": "Developers",
				"groups": [
					{
						"group": "Start building",
						"pages": [
							"api-reference/introduction",
							"api-reference/authentication",
							"core/integrations/mcp-stateless"
						]
					},
					{
						"group": "Endpoint reference",
						"openapi": "openapi.json"
					}
				]
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Website",
					"href": "https://kaneo.app",
					"icon": "globe"
				},
				{
					"anchor": "GitHub",
					"href": "https://github.com/usekaneo/kaneo",
					"icon": "github"
				}
			]
		}
	},
	"navbar": {
		"links": [
			{
				"label": "GitHub",
				"href": "https://github.com/usekaneo/kaneo"
			}
		],
		"primary": {
			"type": "button",
			"label": "Open Kaneo",
			"href": "https://cloud.kaneo.app"
		}
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "cursor"]
	},
	"footer": {
		"socials": {
			"website": "https://kaneo.app",
			"github": "https://github.com/usekaneo/kaneo",
			"x": "https://x.com/usekaneo"
		}
	},
	"seo": {
		"indexing": "all",
		"metatags": {
			"og:site_name": "Kaneo Docs",
			"og:type": "website",
			"og:image": "https://kaneo.app/images/hero.png",
			"twitter:card": "summary_large_image",
			"twitter:site": "@usekaneo",
			"twitter:image": "https://kaneo.app/images/hero.png"
		}
	},
	"integrations": {
		"plausible": {
			"domain": "kaneo.app",
			"server": "plausible.kaneo.app"
		}
	}
}
