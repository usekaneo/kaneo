{
  "name": "@kaneo/api",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vp run compile",
    "lint": "vp check .",
    "typecheck": "vp run check:types",
    "test": "vp run test:run && node --import tsx scripts/mcp-tool-input-bounds.test.ts",
    "test:coverage": "vp test run --config vitest.config.ts --coverage",
    "test:unit": "vp run test:run && node --import tsx scripts/mcp-tool-input-bounds.test.ts",
    "test:integration": "vp run test:integration:run",
    "test:watch": "vp test --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@better-auth/api-key": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@kaneo/email": "workspace:*",
    "@kaneo/gantt": "workspace:*",
    "@kaneo/importers": "workspace:*",
    "@kaneo/mcp": "workspace:*",
    "@kaneo/permissions": "workspace:*",
    "@kaneo/plugin-loader": "workspace:*",
    "@kaneo/plugin-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@octokit/webhooks": "^14.2.0",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/node": "^11.9.0",
    "@sentry/profiling-node": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.14",
    "creem": "^1.13.0",
    "croner": "^11.0.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "semver": "^7.8.5",
    "undici": "^8.12.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
