{
  "manifest_version": 3,
  "name": "Kaneo Agent connector",
  "version": "0.1.0",
  "description": "Shares only the website domain (e.g. github.com) of your active tab with the Kaneo Agent on this computer. Never paths, titles, page content or incognito tabs.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
