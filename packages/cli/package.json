{
  "name": "@kaneo/cli",
  "version": "0.1.1",
  "description": "Official command-line client for Kaneo: sign in, list and update tasks, and script your boards from the terminal",
  "license": "MIT",
  "author": "Kaneo (https://kaneo.app)",
  "homepage": "https://kaneo.app/docs/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/usekaneo/kaneo/",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "kaneo": "dist/kaneo.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "kanban",
    "kaneo",
    "project-management",
    "tasks",
    "terminal"
  ],
  "scripts": {
    "build": "vp run compile",
    "prepublishOnly": "node -e \"throw new Error('Publish the prepared .cache/npm/cli package; see branding/README.md')\"",
    "dev": "tsx src/bin.ts",
    "lint": "vp check .",
    "test": "vp run test:run",
    "test:watch": "vp test --config vitest.config.ts",
    "typecheck": "vp run check:types"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@gabrielbryk/jq-ts": "1.7.0",
    "@kaneo/mcp": "workspace:*",
    "@kaneo/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "effect": "4.0.6",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "@kaneo/branding": "workspace:*"
  },
  "dependencies": {}
}
