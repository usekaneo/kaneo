{
	"name": "@kaneo/planka-import",
	"version": "0.2.0",
	"description": "Migrate PLANKA boards into Kaneo: projects, lists, cards, labels, assignees, checklists and comments, over the public APIs of both",
	"license": "MIT",
	"author": "Kaneo (https://kaneo.app)",
	"homepage": "https://kaneo.app/docs/core/migrations/from-planka",
	"repository": {
		"type": "git",
		"url": "https://github.com/usekaneo/kaneo/",
		"directory": "packages/planka-import"
	},
	"type": "module",
	"bin": {
		"kaneo-planka-import": "dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"planka",
		"kaneo",
		"migration",
		"import",
		"kanban",
		"project-management",
		"cli"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepublishOnly": "pnpm run build",
		"lint": "biome check --write .",
		"start": "node dist/index.js",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@kaneo/typescript-config": "workspace:*",
		"@types/node": "^26.4.0",
		"@types/prompts": "^2.4.9",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
