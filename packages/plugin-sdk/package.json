{
	"name": "@kaneo/plugin-sdk",
	"version": "0.1.0",
	"description": "Build plugins that extend Kaneo's API and web app",
	"license": "MIT",
	"author": "Kaneo (https://kaneo.app)",
	"homepage": "https://kaneo.app/docs/core/plugins",
	"repository": {
		"type": "git",
		"url": "https://github.com/usekaneo/kaneo/",
		"directory": "packages/plugin-sdk"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"kaneo-plugin": "./bin/kaneo-plugin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./web": {
			"types": "./dist/web/index.d.ts",
			"default": "./dist/web/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"default": "./dist/ui/index.js"
		},
		"./theme.css": "./theme.css"
	},
	"files": [
		"bin",
		"dist",
		"theme.css",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"kaneo",
		"kaneo-plugin",
		"plugin",
		"project-management"
	],
	"scripts": {
		"build": "vp run compile",
		"prepublishOnly": "pnpm run build",
		"lint": "vp check .",
		"test": "vp run test:run",
		"test:watch": "vp test --config vitest.config.ts"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.0.0",
		"hono": "^4.0.0",
		"react": "^19.0.0",
		"vite": ">=7.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.2",
		"@kaneo/typescript-config": "workspace:*",
		"@tanstack/react-query": "^5.103.2",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"effect": "4.0.2",
		"hono": "^4.13.9",
		"react": "^19.3.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
