{
	"name": "@kaneo/importers",
	"version": "0.0.0",
	"private": true,
	"description": "Board migration adapters for project management services",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./planka": {
			"types": "./dist/planka/index.d.ts",
			"default": "./dist/planka/index.js"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "vp run compile",
		"lint": "vp check .",
		"test": "vp run test:run",
		"test:watch": "vp test --config vitest.config.ts"
	},
	"dependencies": {
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"@kaneo/branding": "workspace:*"
	},
	"devDependencies": {
		"@kaneo/typescript-config": "workspace:*",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:",
		"@types/turndown": "^5.0.6"
	}
}
