+// Reject oversized bounded containers before parsing elements, including v4 embedded in zod 3.
+function capSize(inst: $ZodType, size: (input: any) => number): void {
+  const caps: [number, checks.$ZodCheck<never>][] = [];
+  for (const ch of inst._zod.def.checks ?? []) {
+    const d = ch._zod.def as any;
+    // A preceding check can rewrite the container, so later bounds cannot gate its raw size.
+    if (!/_(length|size)$|_equals$/.test(d.check)) break;
+    const max = d.maximum ?? d.length ?? d.size;
+    if (max >= 0) caps.push([max, ch]);
+  }
+  if (!caps.length) return;
+  // Classic and Mini initialize their base again; install after all initializers.
+  inst._zod.deferred ??= [];
+  inst._zod.deferred.push(() => {
+    const run = inst._zod.run;
+    inst._zod.run = (payload, ctx) => {
+      const n = size(payload.value);
+      for (const [max, ch] of caps) {
+        if (n > max && ch._zod.def.when!(payload)) {
+          const start = payload.issues.length;
+          ch._zod.check(payload as ParsePayload<never>);
+          (payload.issues[start] as { continue?: boolean }).continue = false;
+          return payload;
+        }
+      }
+      return run(payload, ctx);
+    };
+  });
+}
