{
  "name": "kaneo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run build:dependencies && vp run -r --parallel dev",
    "i18n:check": "node ./scripts/i18n/check.mjs",
    "i18n:check:fix": "node ./scripts/i18n/check.mjs --fix",
    "openapi:check": "node ./scripts/openapi/check.mjs",
    "openapi:check:fix": "node ./scripts/openapi/check.mjs --fix",
    "i18n:report": "node ./scripts/i18n/report.mjs",
    "i18n:report:fix": "node ./scripts/i18n/report.mjs --fix",
    "i18n:schema": "node ./scripts/i18n/schema.mjs && vp fmt i18n/schema.json",
    "lint": "vp check",
    "test": "vp run -r test",
    "test:integration": "vp run -r test:integration",
    "test:e2e": "pnpm --dir tests/e2e test",
    "test:browserstack": "pnpm --dir tests/e2e test:browserstack",
    "typecheck": "vp run -r typecheck",
    "prepare": "husky",
    "format": "vp fmt",
    "build:dependencies": "vp run --filter \"@kaneo/*^...\" build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "linkifyjs": ">=4.3.3",
    "semantic-release": "^24.2.9",
    "tar-fs": ">=3.1.3",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "version": "2.29.3",
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  }
}
