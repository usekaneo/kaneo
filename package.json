{
  "name": "kaneo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run build:dependencies && vp run -r --parallel dev",
    "i18n:check": "node ./scripts/i18n/check.mjs",
    "i18n:check:fix": "node ./scripts/i18n/check.mjs --fix",
    "openapi:check": "node ./scripts/openapi/check.mjs",
    "openapi:check:fix": "node ./scripts/openapi/check.mjs --fix",
    "i18n:report": "node ./scripts/i18n/report.mjs",
    "i18n:report:fix": "node ./scripts/i18n/report.mjs --fix",
    "i18n:schema": "node ./scripts/i18n/schema.mjs && vp fmt i18n/schema.json",
    "lint": "vp check",
    "test": "vp run -r test",
    "test:security:dependencies": "node --test scripts/security/dependency-*.test.mjs",
    "test:integration": "vp run -r test:integration",
    "test:e2e": "pnpm --dir tests/e2e test",
    "test:browserstack": "pnpm --dir tests/e2e test:browserstack",
    "typecheck": "vp run -r typecheck",
    "prepare": "husky",
    "format": "vp fmt",
    "build:dependencies": "vp run --filter \"@kaneo/*^...\" build",
    "branding:check": "node scripts/branding/check.mjs",
    "branding:test": "node --test scripts/branding/*.test.mjs",
    "branding:release": "node scripts/branding/check.mjs --release"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "linkifyjs": ">=4.4.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "semantic-release": "^25.0.9",
    "tar-fs": ">=3.1.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "packageManager": "pnpm@12.18.0",
  "version": "2.49.0",
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  }
}
